// Prisma schema for CityZen game
// Stores game state in Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Player profile - persistent user data
model Player {
  id          String   @id
  name        String
  ownedCityId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// World - the shared game world containing all cities
model World {
  id               String   @id @default("default")
  name             String   @default("World")
  gridSize         Int      @default(8)
  maxCities        Int      @default(64)
  totalPopulation  Int      @default(100)
  initialPopulation Int     @default(100)
  cities           Json     @default("[]")   // Array of WorldCityEntry
  clock            Json     @default("{}")   // GameClock state
  populationData   Json     @default("[]")   // Serialized Person[] (compact tuple format)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// City - metadata, resources, and clock (no grid blob)
model City {
  id        String   @id
  name      String
  ownerId   String

  // Resources (flattened from ResourceState)
  money      Float    @default(5000)
  population Float    @default(0)
  happiness  Float    @default(50)
  taxRate    Int      @default(10)

  // Demand (flattened from DemandState)
  demandResidential Float @default(0.5)
  demandCommercial  Float @default(0)
  demandIndustrial  Float @default(0.3)

  // Clock (flattened from GameClock)
  clockGameTimeMs Float @default(0)
  clockSpeed      Int   @default(1)
  clockGameDay    Int   @default(0)
  clockGameYear   Int   @default(1)

  // Maslow satisfaction summary (city averages, 0-100)
  maslowPhysiological     Float @default(50)
  maslowSafety            Float @default(50)
  maslowLoveBelonging     Float @default(50)
  maslowEsteem            Float @default(50)
  maslowCognitive         Float @default(50)
  maslowAesthetic         Float @default(50)
  maslowSelfActualization Float @default(50)

  // Simulation
  tick Int @default(0)

  // Relations
  buildings Building[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Building - one record per placed building
model Building {
  id               String  @id
  cityId           String
  type             String  // BuildingType enum value
  positionX        Int
  positionZ        Int
  placedBy         String
  placedAt         Int     // Game tick
  developmentLevel Int?    // 0-3 for zones, null for non-zones
  developedAt      Int?    // Game tick of last development

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
}
